# Public URL used in password-reset links and origin checks; use your HTTPS domain.
APP_ORIGIN=https://your-domain.example
# Optional comma-separated administrator recipients for new-order notifications.
ADMIN_NOTIFICATION_EMAILS=
# SMTP server hostname for notification delivery.
SMTP_HOST=
# SMTP server port (587 is commonly used with STARTTLS).
SMTP_PORT=587
# Use true only for SMTP providers requiring implicit TLS, commonly on port 465.
SMTP_SECURE=false
# Sender address accepted by your SMTP provider.
SMTP_FROM="New Chandan Musicals <shop@example.com>"
# Optional approved SMS provider API endpoint.
SMS_PROVIDER_URL=
