# Public base URL used in password-reset links and origin checks.
APP_ORIGIN=https://your-domain.example
# Optional comma-separated administrator recipients for new-order notifications.
ADMIN_NOTIFICATION_EMAILS=
# SMTP server hostname used by the notification worker.
SMTP_HOST=
# SMTP server port, commonly 587 for STARTTLS.
SMTP_PORT=587
# Set true only when the SMTP provider requires implicit TLS, commonly port 465.
SMTP_SECURE=false
# Sender address accepted by your SMTP provider.
SMTP_FROM="New Chandan Musicals <shop@example.com>"
# Optional approved SMS provider API endpoint.
SMS_PROVIDER_URL=
