# Unique random secret of at least 32 characters; keep unchanged after deployment.
APP_ENCRYPTION_KEY=replace-with-a-unique-random-secret
# Optional SMTP authentication username.
SMTP_USER=replace-with-smtp-username
# Optional SMTP authentication password.
SMTP_PASSWORD=replace-with-smtp-password
# Optional SMS provider authentication token.
SMS_PROVIDER_TOKEN=replace-with-sms-provider-token
