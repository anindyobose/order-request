DATABASE_URL="postgresql://ncm:ncm-local-only-change-me@localhost:5432/new_chandan_musicals?schema=public"
POSTGRES_DB="new_chandan_musicals"
POSTGRES_USER="ncm"
POSTGRES_PASSWORD="replace-with-a-unique-postgresql-password"
APP_ORIGIN="http://localhost:3000"
APP_ENCRYPTION_KEY="replace-with-a-different-random-32-byte-secret"
ADMIN_NOTIFICATION_EMAILS=""

# Required before creating the first staff account with `npm run db:seed`.
ADMIN_EMAIL="shop@example.com"
ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
ADMIN_NAME="Shop Administrator"

# SMTP is optional in development. Jobs remain visible in the admin queue if not configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="New Chandan Musicals <shop@example.com>"

# Optional SMS adapter endpoint. Use an approved provider and comply with local consent/sender rules.
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""

# Separate protected destinations are required for offsite backup copies.
NCM_BACKUP_DIRECTORY=""
NCM_OFFSITE_BACKUP_DIRECTORY=""

# Set only when verifying a specific dump in a dedicated *_restore_test database.
NCM_RESTORE_FILE=""
RESTORE_TEST_DATABASE_URL=""
